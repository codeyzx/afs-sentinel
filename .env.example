# Salin ke .env lalu isi. Jangan commit .env.
# Nama variabel mengikuti field Settings di afs/config.py.

# Lokal default ke SQLite (data/afs.db). Di Heroku diisi otomatis oleh add-on Postgres.
DATABASE_URL=sqlite:///data/afs.db

SECTORS_API_KEY=your-sectors-api-key
SECTORS_BASE_URL=https://api.sectors.app

TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_CHAT_ID=123456789

BASE_WEB_URL=http://localhost:8000
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-long-random-string

# Gemini: dipakai hanya untuk Ringkasan AI (Incident Insight). Kosong = fitur mati, sistem tetap jalan.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=20

# Jarak antar-Audit Run terjadwal, dalam hari.
RUN_INTERVAL_DAYS=3

# Opsional: default sudah menunjuk ke berkas di config/
UNIVERSE_PATH=config/universe.json
BACKTEST_CASES_PATH=config/backtest_cases.json
